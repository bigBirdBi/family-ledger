.card + .card {
  margin-top: 24rpx;
}

.bar-row {
  margin-top: 16rpx;
}

.member {
  min-height: 72rpx;
}

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  margin-top: 24rpx;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.col-bar {
  width: 28rpx;
  background: #2563eb;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
}
