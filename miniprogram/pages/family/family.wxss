.card + .card,
.card + t-cell-group {
  margin-top: 24rpx;
}

.members {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.name {
  font-size: 22rpx;
  color: #475569;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
