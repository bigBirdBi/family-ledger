<view class="page">
  <view class="card">
    <text class="section-title">完善资料</text>
    <text class="muted">微信不会自动提供头像昵称，需要你自己设置一次。</text>
    <button class="avatar-btn tap" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
    <t-input label="昵称" type="nickname" value="{{nickname}}" placeholder="请输入昵称" bind:change="onNickname" />
  </view>

  <view class="card">
    <text class="section-title">创建家庭</text>
    <t-button theme="primary" block disabled="{{submitting}}" bind:tap="onCreate">创建家庭账本</t-button>
  </view>

  <view class="card">
    <text class="section-title">加入已有家庭</text>
    <t-input label="邀请码" value="{{inviteCode}}" placeholder="6 位数字" maxlength="6" type="number" bind:change="onInvite" />
    <t-button theme="light" block disabled="{{submitting}}" bind:tap="onJoin">加入家庭</t-button>
  </view>
</view>
