.types {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type {
  flex: 1;
  min-height: 80rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.active {
  border-color: #2563eb;
  color: #1d4ed8;
  font-weight: 600;
  background: #eff6ff;
}

.amount-board {
  margin-bottom: 24rpx;
}

.amount-value {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.card {
  margin-bottom: 24rpx;
}

t-button {
  margin-top: 24rpx;
  margin-bottom: env(safe-area-inset-bottom);
}
