.bill {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  min-height: 88rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.main {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.meta,
.note {
  display: block;
  margin-top: 8rpx;
  color: #475569;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.amount-expense {
  color: #dc2626;
}

.amount-income {
  color: #047857;
}

.amount-refund {
  color: #d97706;
}
